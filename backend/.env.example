# AEROPIX environment template.
# The setup scripts copy this file to ../.env (the repository root) and replace
# SECRET_KEY with a random value. Never commit the real .env.
#
# Relative paths are resolved from the backend/ working directory, which is how
# the README starts Uvicorn.

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string-at-least-24-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database (metadata only) ---------------------------------------------
DATABASE_URL=sqlite:///./data/aeropix.db

# --- Storage backend: local | s3 ------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/media
LOCAL_URL_TTL_SECONDS=900

# --- Amazon S3 mode (used when STORAGE_BACKEND=s3) ------------------------
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
S3_KEY_PREFIX=
S3_PRESIGN_EXPIRE_SECONDS=900
S3_USE_SSE=true
# Never put real credentials in this file. On EC2 the IAM instance profile
# supplies temporary credentials automatically.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_ENDPOINT_URL=

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=15
STORAGE_QUOTA_MB=5120
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif

# --- Web -------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
ALLOWED_HOSTS=*
FRONTEND_DIST=../frontend/dist

# --- Demo data -------------------------------------------------------------
SEED_DEMO_DATA=true
DEMO_EMAIL=demo@aeropix.app
DEMO_PASSWORD=AeropixDemo123!
DEMO_STORAGE_QUOTA_MB=5120
